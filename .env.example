# Travelpayouts (Aviasales) Data API - Token unter https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=

# Telegram Bot (BotFather -> /newbot) + eigene chat_id (z.B. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Routen
ORIGINS=GRU,CGH
DESTINATIONS=BUE,SCL,LIM,CUZ,BOG,CTG,UIO,MVD,ASU,LPB,CCS,GEO
CURRENCY=BRL

MAX_RESULTS_PER_ROUTE=20
SEARCH_MONTHS_AHEAD=6

# Preisalarm
ROLLING_WINDOW_DAYS=14
DROP_PERCENT=0.15
FIXED_THRESHOLD=0
MIN_SAMPLES_FOR_AVERAGE=3
ALERT_COOLDOWN_HOURS=20
MAX_PRICE_EUR=400
REQUIRE_PREFERRED_PATTERN=true

# Sonstiges
DB_PATH=flights.db
LOG_PATH=flight_tracker.log
REQUEST_TIMEOUT=20
